# Server Configuration
PORT=8080
NODE_ENV=development

# Security & Admin Seed Secrets
# (In production, NODE_ENV=production requires explicit SESSION_SECRET and ADMIN_SEED_PASSWORD)
SESSION_SECRET=dev-secret-key-do-not-use-in-prod
ADMIN_SEED_EMAIL=admin@circuittecture.local
ADMIN_SEED_PASSWORD=admin1234

# Rate Limiting Defaults
RATE_LIMIT_SIGNUP=8
RATE_LIMIT_LOGIN=10

# Backup Schedule (ms between automated backups, count retained)
BACKUP_INTERVAL_MS=3600000
BACKUP_RETENTION_COUNT=10
